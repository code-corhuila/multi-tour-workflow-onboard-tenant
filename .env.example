# Variables the service reads; copy to .env (never versioned) and fill in.
# Address the server listens on inside the container
LISTEN_ADDR=:8080
# Base URLs of the two participants (HTTP, inside the platform network).
IDENTITY_AUDIT_BASE_URL=http://identity-audit-api:8080
SECURITY_BASE_URL=http://security:8080
# issued by the identity service, never versioned
SERVICE_TOKEN=
# public key of the security service, to check the caller's JWT: a file, or the PEM text in JWT_PUBLIC_KEY
JWT_PUBLIC_KEY_FILE=<path-to-public-key>
# connection as workflow_onboard_tenant_app
DATABASE_URL=postgres://workflow_onboard_tenant_app:<password>@postgres:5432/<database>
# Step timing (ADR-004 D10): timeout per attempt, 1s to 30s; attempts per step, 1 to 5
STEP_TIMEOUT=5s
STEP_ATTEMPTS=3
